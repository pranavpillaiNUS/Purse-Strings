# Copy to .env (gitignored). Only the checker service ever reads PAYPAL_* values.

# Claude API key for the shopper (npm run shop). Only the shopper reads this, and it
# reads this one name from .env so PayPal credentials never enter its process.
ANTHROPIC_API_KEY=

# PayPal sandbox REST app: developer.paypal.com -> Apps & Credentials -> Sandbox.
# Link the app to a sandbox *business* account created with country = Singapore if you test in SGD.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Backend commands check this name: keep it unset or "sandbox"; any live value
# refuses the command.
# PAYPAL_ENV=sandbox

# Currency for the spike. Must be a 2-decimal currency (SGD or USD).
SPIKE_CURRENCY=SGD

# Local port for PayPal's return_url / cancel_url redirect after buyer approval.
SPIKE_PORT=8787
