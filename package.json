{
  "name": "purse-strings",
  "private": true,
  "type": "module",
  "description": "Your agent shops. You hold the purse strings.",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "spike:paypal": "node --env-file-if-exists=.env services/checker/scripts/paypal-spike.ts",
    "typecheck": "tsc -p .",
    "test": "node --test \"services/**/*.test.ts\" \"apps/**/*.test.ts\" \"packages/**/*.test.ts\"",
    "cli": "node apps/cli/src/main.ts",
    "demo": "node apps/cli/src/main.ts demo",
    "demo:flow": "node apps/cli/src/demo-flow.ts",
    "dashboard": "node apps/cli/src/dashboard.ts",
    "backend": "node apps/cli/src/backend.ts",
    "shop": "node apps/cli/src/shop.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
